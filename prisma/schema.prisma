// ============================================================================
// Club Pikol — Pickleball Club Management System
// Prisma schema (PostgreSQL / Neon)
//
// Runtime uses the pooled connection (DATABASE_URL); migrations use the
// direct connection (DIRECT_URL). Neon provides both in its dashboard.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PRO
}

enum PreferredTime {
  MORNING
  AFTERNOON
  EVENING
  FLEXIBLE
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum MembershipType {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  COMPLIMENTARY
  LIFETIME
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  EXPIRED
  SUSPENDED
  DEACTIVATED
}

enum PaymentMethod {
  GCASH
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentPurpose {
  MEMBERSHIP
  BOOKING
  OPEN_PLAY
  TOURNAMENT
}

enum CourtStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum OpenPlayStatus {
  OPEN
  FULL
  CLOSED
  CANCELLED
  COMPLETED
}

enum OpenPlayParticipantStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
}

enum TournamentDivision {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  MIXED
  MENS
  WOMENS
}

enum TournamentStatus {
  DRAFT
  OPEN
  CLOSED
  ONGOING
  FINISHED
  CANCELLED
}

enum TeamRegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  WITHDRAWN
}

enum BracketType {
  WINNERS
  LOSERS
  GRAND_FINAL
  ROUND_ROBIN
}

enum MatchStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  BYE
  WALKOVER
}

enum AnnouncementType {
  NEWS
  HIGHLIGHT
  EVENT
  PROMO
}

enum NotificationType {
  MEMBERSHIP
  PAYMENT
  BOOKING
  OPEN_PLAY
  TOURNAMENT
  ANNOUNCEMENT
  SYSTEM
}

// ─────────────────────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // OWNER, SUPER_ADMIN, ADMIN, STAFF, MEMBER
  description String?
  permissions Json? // optional fine-grained permissions
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  username              String?        @unique
  passwordHash          String
  firstName                String
  middleName               String?
  lastName                 String
  phone                    String?
  birthdate                DateTime?
  gender                   Gender?
  address                  String?
  emergencyContact         String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  skillLevel               SkillLevel?
  playingExperience        String?
  preferredTime            PreferredTime?
  preferredDays            Weekday[]
  avatarUrl                String?
  bio                      String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  isActive      Boolean       @default(true)
  accountStatus AccountStatus @default(ACTIVE)
  emailVerified Boolean       @default(false)
  lastLoginAt   DateTime?

  // Relations
  memberships            Membership[]          @relation("UserMemberships")
  approvedMemberships    Membership[]          @relation("MembershipApprover")
  payments               Payment[]             @relation("UserPayments")
  verifiedPayments       Payment[]             @relation("PaymentVerifier")
  bookings               Booking[]             @relation("BookingUser")
  assignedBookings       Booking[]             @relation("BookingStaff")
  approvedBookings       Booking[]             @relation("BookingApprover")
  openPlaysCreated       OpenPlay[]            @relation("OpenPlayCreator")
  openPlayParticipations OpenPlayParticipant[]
  tournamentsCreated     Tournament[]          @relation("TournamentCreator")
  tournamentPlayers      TournamentPlayer[]
  announcements          Announcement[]        @relation("AnnouncementAuthor")
  notifications          Notification[]
  auditLogs              AuditLog[]
  achievements           UserAchievement[]
  stats                  PlayerStats?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@index([accountStatus])
}

// ─────────────────────────────────────────────────────────────
// Membership & Payments
// ─────────────────────────────────────────────────────────────

model Membership {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  type            MembershipType
  status          MembershipStatus @default(PENDING)
  fee              Decimal          @db.Decimal(10, 2)
  membershipNumber String?          @unique
  startDate        DateTime?
  endDate          DateTime?
  approvedById    String?
  approvedBy      User?            @relation("MembershipApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  payments        Payment[]        @relation("MembershipPayments")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

model Payment {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  purpose         PaymentPurpose
  amount          Decimal        @db.Decimal(10, 2)
  method          PaymentMethod
  referenceNumber String?
  proofUrl        String?
  status          PaymentStatus  @default(PENDING)
  notes           String?
  rejectionReason String?
  verifiedById    String?
  verifiedBy      User?          @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?
  paidAt          DateTime?

  // Optional links to whatever the payment is for (one will be set)
  membershipId          String?
  membership            Membership?          @relation("MembershipPayments", fields: [membershipId], references: [id], onDelete: SetNull)
  bookingId             String?
  booking               Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  openPlayParticipantId String?
  openPlayParticipant   OpenPlayParticipant? @relation(fields: [openPlayParticipantId], references: [id], onDelete: SetNull)
  tournamentTeamId      String?
  tournamentTeam        TournamentTeam?      @relation(fields: [tournamentTeamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([purpose])
}

// ─────────────────────────────────────────────────────────────
// Courts & Bookings
// ─────────────────────────────────────────────────────────────

model Court {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  surface     String?
  isIndoor    Boolean           @default(false)
  status      CourtStatus       @default(AVAILABLE)
  bookings    Booking[]
  matches     TournamentMatch[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Booking {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation("BookingUser", fields: [userId], references: [id], onDelete: Cascade)
  courtId         String?
  court           Court?        @relation(fields: [courtId], references: [id], onDelete: SetNull)
  date            DateTime
  startTime       DateTime
  endTime         DateTime
  status          BookingStatus @default(PENDING)
  purpose         String?
  notes           String?
  price           Decimal?      @db.Decimal(10, 2)
  invoiceNumber   String?       @unique
  assignedStaffId String?
  assignedStaff   User?         @relation("BookingStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  approvedById    String?
  approvedBy      User?         @relation("BookingApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([courtId])
  @@index([status])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// Open Play
// ─────────────────────────────────────────────────────────────

model OpenPlay {
  id           String                @id @default(cuid())
  title        String
  description  String?
  date         DateTime
  startTime    DateTime
  endTime      DateTime
  venue        String
  maxPlayers   Int
  fee          Decimal               @default(0) @db.Decimal(10, 2)
  skillLevel   SkillLevel?
  bannerUrl    String?
  status       OpenPlayStatus        @default(OPEN)
  createdById  String
  createdBy    User                  @relation("OpenPlayCreator", fields: [createdById], references: [id])
  participants OpenPlayParticipant[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status])
  @@index([date])
}

model OpenPlayParticipant {
  id               String                    @id @default(cuid())
  openPlayId       String
  openPlay         OpenPlay                  @relation(fields: [openPlayId], references: [id], onDelete: Cascade)
  userId           String
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           OpenPlayParticipantStatus @default(REGISTERED)
  waitlistPosition Int?
  payments         Payment[]
  joinedAt         DateTime                  @default(now())

  @@unique([openPlayId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Tournaments & Brackets
// ─────────────────────────────────────────────────────────────

model Tournament {
  id                   String             @id @default(cuid())
  name                 String
  bannerUrl            String?
  description          String?
  division             TournamentDivision
  format               TournamentFormat   @default(SINGLE_ELIMINATION)
  date                 DateTime
  endDate              DateTime?
  venue                String
  entryFee             Decimal            @default(0) @db.Decimal(10, 2)
  registrationDeadline DateTime?
  maxTeams             Int?
  teamSize             Int                @default(2)
  rules                String?
  prizes               String?
  status               TournamentStatus   @default(DRAFT)

  championId String?
  champion   TournamentTeam? @relation("TournamentChampion", fields: [championId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("TournamentCreator", fields: [createdById], references: [id])

  teams     TournamentTeam[]  @relation("TournamentTeams")
  matches   TournamentMatch[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([division])
}

model TournamentTeam {
  id           String                 @id @default(cuid())
  tournamentId String
  tournament   Tournament             @relation("TournamentTeams", fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  seed         Int?
  status       TeamRegistrationStatus @default(PENDING)

  // Round-robin / standings aggregates
  wins          Int @default(0)
  losses        Int @default(0)
  pointsFor     Int @default(0)
  pointsAgainst Int @default(0)

  players  TournamentPlayer[]
  payments Payment[]

  matchesAsTeamA TournamentMatch[] @relation("MatchTeamA")
  matchesAsTeamB TournamentMatch[] @relation("MatchTeamB")
  matchesWon     TournamentMatch[] @relation("MatchWinner")
  matchesLost    TournamentMatch[] @relation("MatchLoser")
  championOf     Tournament[]      @relation("TournamentChampion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId])
}

model TournamentPlayer {
  id         String          @id @default(cuid())
  teamId     String
  team       TournamentTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String // denormalized display name (member or guest)
  email      String?
  skillLevel SkillLevel?
  seed       Int?
  createdAt  DateTime        @default(now())

  @@index([teamId])
  @@index([userId])
}

model TournamentMatch {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  matchNumber  Int
  bracket      BracketType @default(WINNERS)

  teamAId  String?
  teamA    TournamentTeam? @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: SetNull)
  teamBId  String?
  teamB    TournamentTeam? @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: SetNull)
  winnerId String?
  winner   TournamentTeam? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  loserId  String?
  loser    TournamentTeam? @relation("MatchLoser", fields: [loserId], references: [id], onDelete: SetNull)

  scoreA      Int? // games won by team A (summary)
  scoreB      Int? // games won by team B (summary)
  courtId     String?
  court       Court?      @relation(fields: [courtId], references: [id], onDelete: SetNull)
  scheduledAt DateTime?
  status      MatchStatus @default(PENDING)

  // Bracket routing via self-relations (winner and loser progression)
  nextMatchId        String?
  nextMatch          TournamentMatch?  @relation("MatchProgression", fields: [nextMatchId], references: [id], onDelete: SetNull)
  feederMatches      TournamentMatch[] @relation("MatchProgression")
  nextMatchLoserId   String?
  nextMatchLoser     TournamentMatch?  @relation("MatchLoserProgression", fields: [nextMatchLoserId], references: [id], onDelete: SetNull)
  loserFeederMatches TournamentMatch[] @relation("MatchLoserProgression")

  scores    TournamentScore[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([tournamentId])
  @@index([status])
}

model TournamentScore {
  id         String          @id @default(cuid())
  matchId    String
  match      TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNumber Int
  teamAScore Int
  teamBScore Int

  @@unique([matchId, gameNumber])
}

// ─────────────────────────────────────────────────────────────
// Content, Notifications, Audit, Settings
// ─────────────────────────────────────────────────────────────

model Announcement {
  id          String           @id @default(cuid())
  title       String
  content     String
  type        AnnouncementType @default(NEWS)
  imageUrl    String?
  videoUrl    String?
  mediaUrls   String[]
  isPinned    Boolean          @default(false)
  isPublished Boolean          @default(true)
  publishedAt DateTime?
  authorId    String
  author      User             @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isPublished])
  @@index([isPinned])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String?
  description String?
  updatedAt   DateTime @updatedAt
}

model Achievement {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  iconUrl     String?
  criteria    Json?
  users       UserAchievement[]
  createdAt   DateTime          @default(now())
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  awardedAt     DateTime    @default(now())

  @@unique([userId, achievementId])
}

model PlayerStats {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchesPlayed     Int      @default(0)
  wins              Int      @default(0)
  losses            Int      @default(0)
  tournamentsPlayed Int      @default(0)
  tournamentsWon    Int      @default(0)
  points            Int      @default(0)
  updatedAt         DateTime @updatedAt
}
